{
  "vlm": {
    "imageRef": "docker.io/vllm/vllm-openai:v0.29.0",
    "command": [
      "vllm",
      "serve"
    ],
    "args": [
      "PaddlePaddle/PaddleOCR-VL-1.6",
      "--served-model-name",
      "PaddleOCR-VL-1.6-0.9B",
      "--trust-remote-code",
      "--host",
      "0.0.0.0",
      "--port",
      "8118",
      "--gpu-memory-utilization",
      "0.28",
      "--max-num-batched-tokens",
      "8192",
      "--max-num-seqs",
      "128",
      "--max-model-len",
      "16384",
      "--mm-processor-cache-gb",
      "0",
      "--limit-mm-per-prompt",
      "{\"image\":1}"
    ],
    "resources": {
      "requests": {
        "cpu": "1",
        "memory": "4Gi"
      },
      "limits": {
        "memory": "16Gi",
        "nvidia.com/gpu": 1
      }
    },
    "startupTimeoutSeconds": 1200,
    "benchmarkRuntimePatch": "",
    "securityContext": {}
  },
  "pipeline": {
    "instances": 2,
    "resources": {
      "requests": {
        "cpu": "1",
        "memory": "7Gi"
      },
      "limits": {
        "memory": "16Gi"
      }
    },
    "benchmarkProfiling": false,
    "config": {
      "vlmMaxConcurrency": 64
    }
  },
  "gateway": {
    "resources": {
      "requests": {
        "cpu": "100m",
        "memory": "256Mi"
      },
      "limits": {
        "memory": "2Gi"
      }
    }
  },
  "terminationGracePeriodSeconds": 900,
  "replicas": 1,
  "autoscaling": {
    "enabled": false
  }
}
